rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email in ['angeloyeshuac@gmail.com', 'angcalderon@estudiantec.cr'];
    }

    function isModerator() {
      return isOwner()
        || (request.auth != null && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/moderators/$(request.auth.token.email)));
    }

    function isAsociado() {
      return isOwner()
        || (request.auth != null && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/padron/$(request.auth.token.email)));
    }

    function isJunta() {
      return isOwner()
        || (request.auth != null && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/junta/$(request.auth.token.email)));
    }

    function isFiscalia() {
      return isOwner()
        || (request.auth != null && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/fiscalia/$(request.auth.token.email)));
    }

    match /moderators/{email} {
      allow read: if isModerator();
      allow create, delete: if isModerator();
      allow update: if isModerator();
    }

    match /padron/{email} {
      allow read, create, update, delete: if isJunta();
    }

    // Cualquiera puede consultar un correo puntual (lo usa el registro de cuentas de Junta),
    // pero el listado completo con correos solo lo ve la Junta. La página pública lee
    // config/junta_publica, que contiene únicamente nombre y puesto (RI Art. 143).
    match /junta/{email} {
      allow get: if true;
      allow list: if isJunta();
      allow create, update, delete: if isJunta();
    }

    // RI Art. 42: Fiscalía es independiente de la Junta, así que la persona Fiscal saliente registra a la
    // entrante. Por decisión de la Junta (2026-09) la Junta también puede hacerlo, para que el cargo no quede
    // sin acceso si la Fiscalía saliente olvida el traspaso.
    match /fiscalia/{email} {
      allow read: if isJunta() || isFiscalia();
      allow create, update, delete: if isJunta() || isFiscalia();
    }

    match /config/{document=**} {
      allow read: if true;
      allow write: if isJunta();
    }

    // Inventario de bienes de la asociación. Consulta pública, administración exclusiva de Junta.
    match /inventario/{itemId} {
      allow read: if true;
      allow create, update, delete: if isJunta();
    }

    // Solicitudes de préstamo: el formulario es abierto porque el préstamo se formaliza en
    // físico con la firma del registro (RI Art. 120), donde la Junta verifica la condición de
    // persona Asociada. Solo Junta puede leer/gestionar el listado de solicitudes.
    // La fecha prevista de devolución es obligatoria (RI Art. 122).
    match /prestamoSolicitudes/{solicitudId} {
      allow read, update, delete: if isJunta();
      allow create: if request.resource.data.itemTipo in ['aematec', 'biblioteca']
        && request.resource.data.itemId is string && request.resource.data.itemId.size() > 0
        && request.resource.data.itemNombre is string && request.resource.data.itemNombre.size() > 0
        && request.resource.data.itemNombre.size() <= 160
        && request.resource.data.solicitanteNombre is string && request.resource.data.solicitanteNombre.size() > 0
        && request.resource.data.solicitanteNombre.size() <= 120
        && request.resource.data.solicitanteCarne is string && request.resource.data.solicitanteCarne.size() > 0
        && request.resource.data.solicitanteCarne.size() <= 30
        && request.resource.data.solicitanteContacto is string && request.resource.data.solicitanteContacto.size() > 0
        && request.resource.data.solicitanteContacto.size() <= 160
        && request.resource.data.fechaPrevista is string && request.resource.data.fechaPrevista.size() > 0
        && request.resource.data.fechaPrevista.size() <= 20
        && request.resource.data.notas is string && request.resource.data.notas.size() <= 300
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.keys().hasOnly([
          'itemId', 'itemTipo', 'itemNombre', 'itemCodigo', 'solicitanteNombre',
          'solicitanteCarne', 'solicitanteContacto', 'fechaPrevista', 'notas', 'estado', 'createdAt'
        ]);
    }

    match /resources/{resourceId} {
      allow read: if resource.data.published == true
        || isModerator();
      allow create: if request.resource.data.section in ['docentes', 'academico']
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 300
        && request.resource.data.author is string && request.resource.data.author.size() > 0
        && request.resource.data.author.size() <= 120
        && request.resource.data.materials is string && request.resource.data.materials.size() <= 300
        && request.resource.data.labels is list && request.resource.data.labels.size() > 0
        && request.resource.data.labels.size() <= 13
        && request.resource.data.grade is string && request.resource.data.grade.size() <= 30
        && request.resource.data.educationalCycle is string && request.resource.data.educationalCycle.size() <= 40
        && request.resource.data.course is string && request.resource.data.course.size() <= 80
        && request.resource.data.courseCode is string && request.resource.data.courseCode.size() <= 20
        && request.resource.data.explanationUrl is string && request.resource.data.explanationUrl.size() <= 500
        && request.resource.data.requiresInternet is bool
        && request.resource.data.type in ['Actividad', 'Juego', 'Planeamiento', 'Guía didáctica', 'Recurso digital', 'Examen', 'Apuntes', 'Solución', 'Práctica']
        && request.resource.data.extension in ['', 'pdf', 'docx', 'pptx', 'xlsx', 'zip', 'ggb']
        && request.resource.data.size is number && request.resource.data.size <= 25 * 1024 * 1024
        && request.resource.data.status == 'pending'
        && request.resource.data.published == false
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'section', 'type', 'labels', 'grade', 'educationalCycle',
          'course', 'courseCode', 'author', 'materials', 'requiresInternet', 'explanationUrl',
          'explanation', 'extension', 'size', 'storagePath', 'fileUrl', 'status', 'published', 'createdAt'
        ]);
      // Los moderadores pueden editar los metadatos de cualquier recurso (incluso ya
      // publicado), pero nunca el autor ni el archivo/contenido original.
      allow update: if isModerator()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'description', 'labels', 'type', 'explanationUrl',
          'grade', 'materials', 'requiresInternet', 'course', 'courseCode',
          'status', 'published'
        ]);
      allow delete: if isModerator();
    }
  }
}