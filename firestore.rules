rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email in ['angeloyeshuac@gmail.com', 'angcalderon@estudiantec.cr'];
    }

    function isModerator() {
      return isOwner()
        || (request.auth != null && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/moderators/$(request.auth.token.email)));
    }

    function isJunta() {
      return isOwner()
        || (request.auth != null && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/junta/$(request.auth.token.email)));
    }

    // Persona Fiscal registrada, sin el acceso de dueño (RI Art. 42: independencia de la Fiscalía).
    function esPersonaFiscal() {
      return request.auth != null && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/fiscalia/$(request.auth.token.email));
    }

    function isFiscalia() {
      return isOwner()
        || (request.auth != null && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/fiscalia/$(request.auth.token.email)));
    }

    match /moderators/{email} {
      allow read: if isModerator();
      allow create, delete: if isModerator();
      allow update: if isModerator();
    }

    match /padron/{email} {
      allow read, create, update, delete: if isJunta();
    }

    // Solo la Junta consulta y edita la lista. Cada cuenta puede leer su propio documento (lo hace roles.js
    // para saber si es Junta); ya nadie anónimo puede consultar si un correo es de la Junta (RI Art. 143).
    // La página pública lee config/junta_publica, que contiene únicamente nombre y puesto.
    match /junta/{email} {
      allow get: if isJunta() || (request.auth != null && request.auth.token.email == email);
      allow list: if isJunta();
      allow create, update, delete: if isJunta();
    }

    // RI Art. 42: Fiscalía es independiente de la Junta, así que la persona Fiscal saliente registra a la
    // entrante. Por decisión de la Junta (2026-09) la Junta también puede hacerlo, para que el cargo no quede
    // sin acceso si la Fiscalía saliente olvida el traspaso.
    match /fiscalia/{email} {
      allow read: if isJunta() || isFiscalia();
      allow create, update, delete: if isJunta() || isFiscalia();
    }

    match /config/{document=**} {
      allow read: if true;
      allow write: if isJunta();
    }

    // Inventario de bienes de la asociación. Consulta pública, administración exclusiva de Junta.
    match /inventario/{itemId} {
      allow read: if true;
      allow create, update, delete: if isJunta();
    }

    // Solicitudes de préstamo: el formulario es abierto porque el préstamo se formaliza en
    // físico con la firma del registro (RI Art. 120), donde la Junta verifica la condición de
    // persona Asociada. Solo Junta puede leer/gestionar el listado de solicitudes.
    // La fecha prevista de devolución es obligatoria (RI Art. 122).
    match /prestamoSolicitudes/{solicitudId} {
      allow read, update, delete: if isJunta();
      allow create: if request.resource.data.itemTipo in ['aematec', 'biblioteca']
        && request.resource.data.itemId is string && request.resource.data.itemId.size() > 0
        && request.resource.data.itemNombre is string && request.resource.data.itemNombre.size() > 0
        && request.resource.data.itemNombre.size() <= 160
        && request.resource.data.solicitanteNombre is string && request.resource.data.solicitanteNombre.size() > 0
        && request.resource.data.solicitanteNombre.size() <= 120
        && request.resource.data.solicitanteCarne is string && request.resource.data.solicitanteCarne.size() > 0
        && request.resource.data.solicitanteCarne.size() <= 30
        && request.resource.data.solicitanteContacto is string && request.resource.data.solicitanteContacto.size() > 0
        && request.resource.data.solicitanteContacto.size() <= 160
        && request.resource.data.fechaPrevista is string && request.resource.data.fechaPrevista.size() > 0
        && request.resource.data.fechaPrevista.size() <= 20
        && request.resource.data.notas is string && request.resource.data.notas.size() <= 300
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.keys().hasOnly([
          'itemId', 'itemTipo', 'itemNombre', 'itemCodigo', 'solicitanteNombre',
          'solicitanteCarne', 'solicitanteContacto', 'fechaPrevista', 'notas', 'estado', 'createdAt'
        ]);
    }

    // Reportes del asistente básico del sitio (buscar páginas / reportar un problema). El formulario
    // es abierto porque cualquier visitante puede toparse con un error; solo Moderadores los leen y
    // les llega un correo automático (functions/index.js). No hay nombre ni cuenta: si la persona
    // quiere respuesta, deja su correo en "contacto" por su cuenta, nunca es obligatorio.
    match /chatbotReportes/{reporteId} {
      allow read, delete: if isModerator();
      allow create: if request.resource.data.mensaje is string && request.resource.data.mensaje.size() > 0
        && request.resource.data.mensaje.size() <= 600
        && request.resource.data.contacto is string && request.resource.data.contacto.size() <= 160
        && request.resource.data.pagina is string && request.resource.data.pagina.size() <= 200
        && request.resource.data.keys().hasOnly(['mensaje', 'contacto', 'pagina', 'createdAt']);
      allow update: if false;
    }

    // ---------- Trámites (RI Título V, Cap. IV) ----------
    // Nadie los crea desde el navegador: los crean las Cloud Functions (functions/tramites.js), que verifican
    // el correo institucional y el padrón. Aquí solo se define quién los lee y qué puede cambiar la Junta.
    match /tramites/{tramiteId} {
      allow read: if isJunta()
        || (request.auth != null && resource.data.solicitanteUid == request.auth.uid);
      allow create, delete: if false;
      // La Junta cambia el estado, responde y registra prórrogas. RI Art. 82: todo rechazo debe quedar motivado.
      allow update: if isJunta()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estado', 'respuestas', 'prorrogaInformada', 'motivacionRechazo', 'actualizadoEn'
        ])
        && request.resource.data.estado in ['recibido', 'en_revision', 'resuelto', 'rechazado']
        && (request.resource.data.estado != 'rechazado'
          || (request.resource.data.motivacionRechazo is string && request.resource.data.motivacionRechazo.size() >= 10));

      match /adhesiones/{email} {
        allow read: if isJunta();
        allow write: if false;
      }
    }

    // Avance público de las solicitudes de AGEC extraordinaria (sin nombres ni correos).
    match /agecPublicas/{tramiteId} {
      allow read: if true;
      allow write: if false;
    }

    // Consultas y denuncias a Fiscalía. RI Art. 42: solo la Fiscalía las lee; la Junta NO, y los dueños del
    // sitio tampoco (por eso no se usa isFiscalia(), que incluye a los dueños). Quien envió un caso
    // identificado puede ver el suyo; los anónimos se consultan con el código de seguimiento (función).
    match /fiscaliaCasos/{casoId} {
      allow read: if esPersonaFiscal()
        || (request.auth != null && resource.data.remitenteUid == request.auth.uid);
      allow create, delete: if false;
      allow update: if esPersonaFiscal()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'respuestas', 'actualizadoEn'])
        && request.resource.data.estado in ['recibido', 'en_revision', 'resuelto'];
    }

    // Límite diario de trámites por cuenta; solo lo usan las funciones.
    match /limites/{uid} {
      allow read, write: if false;
    }

    // Los enlaces de los materiales se muestran como href en páginas públicas: solo https (evita javascript: y otros).
    function enlaceSeguro(valor, puedeIrVacio) {
      return valor is string && valor.size() <= 2048
        && ((puedeIrVacio && valor == '') || valor.matches('https://[^\\s]+'));
    }

    match /resources/{resourceId} {
      allow read: if resource.data.published == true
        || isModerator();
      allow create: if request.resource.data.section in ['docentes', 'academico']
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 300
        && request.resource.data.author is string && request.resource.data.author.size() > 0
        && request.resource.data.author.size() <= 120
        && request.resource.data.materials is string && request.resource.data.materials.size() <= 300
        && request.resource.data.labels is list && request.resource.data.labels.size() > 0
        && request.resource.data.labels.size() <= 13
        && request.resource.data.grade is string && request.resource.data.grade.size() <= 30
        && request.resource.data.educationalCycle is string && request.resource.data.educationalCycle.size() <= 40
        && request.resource.data.course is string && request.resource.data.course.size() <= 80
        && request.resource.data.courseCode is string && request.resource.data.courseCode.size() <= 20
        && enlaceSeguro(request.resource.data.explanationUrl, true)
        && (!('fileUrl' in request.resource.data) || enlaceSeguro(request.resource.data.fileUrl, false))
        && (!('explanation' in request.resource.data) || request.resource.data.explanation == null
          || (request.resource.data.explanation is map
            && request.resource.data.explanation.keys().hasOnly(['storagePath', 'fileUrl', 'extension', 'size'])
            && enlaceSeguro(request.resource.data.explanation.fileUrl, false)))
        && request.resource.data.requiresInternet is bool
        && request.resource.data.type in ['Actividad', 'Juego', 'Planeamiento', 'Guía didáctica', 'Recurso digital', 'Examen', 'Apuntes', 'Solución', 'Práctica']
        && request.resource.data.extension in ['', 'pdf', 'docx', 'pptx', 'xlsx', 'zip', 'ggb']
        && request.resource.data.size is number && request.resource.data.size <= 25 * 1024 * 1024
        && request.resource.data.status == 'pending'
        && request.resource.data.published == false
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'section', 'type', 'labels', 'grade', 'educationalCycle',
          'course', 'courseCode', 'author', 'materials', 'requiresInternet', 'explanationUrl',
          'explanation', 'extension', 'size', 'storagePath', 'fileUrl', 'status', 'published', 'createdAt'
        ]);
      // Los moderadores pueden editar los metadatos de cualquier recurso (incluso ya
      // publicado), pero nunca el autor ni el archivo/contenido original.
      allow update: if isModerator()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['explanationUrl'])
          || enlaceSeguro(request.resource.data.explanationUrl, true))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'description', 'labels', 'type', 'explanationUrl',
          'grade', 'materials', 'requiresInternet', 'course', 'courseCode',
          'status', 'published'
        ]);
      allow delete: if isModerator();
    }
  }
}