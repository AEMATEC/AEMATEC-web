rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /recursos/{section}/{fileName} {
      function isModerator() {
        return request.auth != null
          && ((request.auth.token.email_verified == true && request.auth.token.email in ['aematec@estudiantec.cr', 'aeemac.tec@gmail.com'])
            || (request.auth.token.email_verified == true
              && firestore.exists(/databases/(default)/documents/moderators/$(request.auth.token.email))));
      }

      allow read: if true;
      // Cualquiera puede subir material nuevo; solo un moderador puede reemplazar un archivo existente.
      allow write: if section in ['docentes', 'academico']
        && request.resource.size <= 25 * 1024 * 1024
        && fileName.matches('^[a-f0-9-]+(-explicacion)?\\.(pdf|docx|pptx|xlsx|zip|ggb)$')
        && request.resource.contentType in [
          'application/pdf',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'application/vnd.openxmlformats-officedocument.presentationml.presentation',
          'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
          'application/zip', 'application/x-zip-compressed',
          'application/vnd.geogebra.file',
          'application/octet-stream'
        ]
        && (resource == null || isModerator());
      allow delete: if isModerator();
    }

    match /inventario/biblioteca/{fileName} {
      function isJunta() {
        return request.auth != null
          && ((request.auth.token.email_verified == true && request.auth.token.email in ['aematec@estudiantec.cr', 'aeemac.tec@gmail.com'])
            || (request.auth.token.email_verified == true
              && firestore.exists(/databases/(default)/documents/junta/$(request.auth.token.email))));
      }

      allow read: if true;
      allow write: if request.resource.size <= 5 * 1024 * 1024
        && fileName.matches('^[a-f0-9-]+\\.(jpg|jpeg|png|webp)$')
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && isJunta();
      allow delete: if isJunta();
    }

    // Fotos de perfil de la Junta y la Fiscalía (páginas públicas; solo con consentimiento, Ley 8968).
    // RI Art. 42: la Fiscalía maneja las suyas sin la Junta, pero no toca las de la Junta. La Junta sí puede
    // editar las de Fiscalía (misma excepción acordada que la lista `fiscalia`).
    match /perfiles/{lista}/{fileName} {
      function esDueno() {
        return request.auth.token.email in ['aematec@estudiantec.cr', 'aeemac.tec@gmail.com'];
      }
      function estaEn(coleccion) {
        return firestore.exists(/databases/(default)/documents/$(coleccion)/$(request.auth.token.email));
      }
      function puedeEditar() {
        return request.auth != null && request.auth.token.email_verified == true
          && (esDueno() || estaEn('junta') || (lista == 'fiscalia' && estaEn('fiscalia')));
      }

      allow read: if true;
      allow write: if lista in ['junta', 'fiscalia']
        && request.resource.size <= 5 * 1024 * 1024
        && fileName.matches('^[a-f0-9-]+\\.(jpg|jpeg|png|webp)$')
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && puedeEditar();
      allow delete: if puedeEditar();
    }
  }
}
