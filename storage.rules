rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /recursos/{section}/{fileName} {
      function isModerator() {
        return request.auth != null
          && (request.auth.token.email in ['angeloyeshuac@gmail.com', 'angcalderon@estudiantec.cr']
            || firestore.exists(/databases/(default)/documents/moderators/$(request.auth.token.email)));
      }

      allow read: if true;
      // Cualquiera puede subir material nuevo; solo un moderador puede reemplazar un archivo existente.
      allow write: if section in ['docentes', 'academico']
        && request.resource.size <= 25 * 1024 * 1024
        && fileName.matches('^[a-f0-9-]+(-explicacion)?\\.(pdf|docx|pptx|xlsx|zip|ggb)$')
        && request.resource.contentType in [
          'application/pdf',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'application/vnd.openxmlformats-officedocument.presentationml.presentation',
          'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
          'application/zip', 'application/x-zip-compressed',
          'application/vnd.geogebra.file',
          'application/octet-stream'
        ]
        && (resource == null || isModerator());
      allow delete: if isModerator();
    }
  }
}
